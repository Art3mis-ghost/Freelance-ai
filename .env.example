# Server Configuration (Windows Local & Cloud Deployment)
PORT=3000
# Bind strictly to localhost (127.0.0.1) by default. Set 0.0.0.0 only behind a trusted reverse proxy or container.
HOST=127.0.0.1
TRUST_PROXY=false
NODE_ENV=development

# Local Storage & Isolated Workspace Paths
WORKSPACE_DIR=./FreelanceAgentHub
DB_PATH=./FreelanceAgentHub/data/hub.db

# Local Authentication
# Optional override; if blank, use localhost-only first-run setup in UI.
HUB_ADMIN_PASSCODE=
# Optional first-run setup token required by /api/auth/bootstrap (auto-generated by scripts/install.ps1 on Windows).
HUB_SETUP_TOKEN=

# Secret Encryption Key (32+ chars recommended; auto-generated during Windows install or persisted outside the DB)
HUB_SECRET_ENCRYPTION_KEY=
# Set to true to refuse startup if existing encrypted provider keys cannot be decrypted with the active key.
HUB_STRICT_KEY_CHECK=false

# Local-First AI Provider (Ollama on Windows / Localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Optional External Fallback Providers (OpenAI-Compatible & FreeLLMAPI)
FREELLM_BASE_URL=
FREELLM_API_KEY=
FREELLM_MODEL=

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional Server-Side Gemini Fallback API Key
GEMINI_API_KEY=

# Application URL (used for cloud deployments)
APP_URL=http://localhost:3000
